# Avocado API environment (copy to .env for local dev)

# Local dev defaults to SQLite; Railway's Postgres plugin injects DATABASE_URL.
# DATABASE_URL=postgresql://user:pass@host:5432/avocado

ENVIRONMENT=development

# REQUIRED in production — generate a long random string.
SECRET_KEY=dev-insecure-change-me

# Comma-separated allowed origins for the web app (use the web URL in prod).
CORS_ORIGINS=*

# Seed synthetic demo data on container start (safe no-op if data exists).
SEED_ON_START=false

# AI (optional). Without a key, DI plans use the structured template.
AI_PROVIDER=none          # none | anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5
